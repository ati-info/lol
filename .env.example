# ---- Required ----
# Get it free from @BotFather on Telegram
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Optional (bot still works without these) ----
# Free AI key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Models to try, comma separated (free tier friendly)
GEMINI_MODELS=gemini-2.0-flash-lite,gemini-2.0-flash,gemini-1.5-flash

# Where finished posts go. @channelusername or -100xxxxxxxxxx
# (add the bot as channel admin first!)
CHANNEL_ID=

# Public channel link used for the Join button / caption footer
CHANNEL_LINK=https://t.me/yourchannel

# Comma separated admin telegram user ids
ADMIN_IDS=

# Display name in /start
BOT_NAME=FileCraft AI

# Only used when you self-host behind SSL; on Render it's auto-detected
WEBHOOK_URL=

# Port (Render sets this automatically)
PORT=8080
