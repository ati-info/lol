# ---- Required ----
# Get it free from @BotFather on Telegram
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Optional (bot still works without these) ----
# Free AI key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Models to try, comma separated (free tier friendly - rotated on 429/quota)
GEMINI_MODELS=gemini-2.5-flash-lite,gemini-2.0-flash-lite,gemini-2.0-flash

# Where finished posts go. @channelusername or -100xxxxxxxxxx
# (add the bot as channel admin first!)
CHANNEL_ID=

# Public channel link used for the Join button / caption footer
CHANNEL_LINK=https://t.me/yourchannel

# Comma separated admin telegram user ids
ADMIN_IDS=

# Display name in /start
BOT_NAME=FileCraft AI

# Only used when you self-host behind SSL; on Render it's auto-detected
WEBHOOK_URL=

# Port (Render sets this automatically)
PORT=8080

# ---- Userbot (Personal Account) Settings ----
# Get USERBOT_API_ID and USERBOT_API_HASH from https://my.telegram.org
USERBOT_API_ID=
USERBOT_API_HASH=
USERBOT_PHONE=+88017XXXXXXXX

# Where to check for files. @channelusername or -100xxxxxxxxxx
USERBOT_TARGET_CHANNEL=@your_target_channel

# Where the userbot forwards files. 
# Usually, this should be your BOT's username (e.g. @FileCraftAIBot)
# so the bot processes the files and posts them to CHANNEL_ID.
USERBOT_DESTINATION=@your_bot_username

# Starting message ID to check (e.g. 1 or 12)
USERBOT_LAST_CHECKED_ID=0

# Time interval in seconds between checks (default: 300 = 5 minutes)
USERBOT_CHECK_INTERVAL_SECONDS=300
